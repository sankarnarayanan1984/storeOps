{
  "name": "storeops-api",
  "version": "0.1.0",
  "description": "StoreOps REST API \u2014 retail store operations management (stub implementation)",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm run depcheck && npm run test:coverage",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "docker:build": "docker build -t storeops-api:local .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "deploy:azure": "bash infra/azure/deploy.sh"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
